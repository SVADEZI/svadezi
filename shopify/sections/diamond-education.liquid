{%- comment -%}
  sections/diamond-education.liquid — minimal "Four Cs" diamond education section
  Fonts: Cormorant Garamond (display serif) + Inter (sans). Loaded from Google Fonts.
  Heading, intro, the four C cards, and each scale position are editable in the theme editor.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  #de-{{ section.id }}{--ink:#1c1a20;--muted:#8b8794;--line:#ece9e4;--bg:{{ section.settings.bg }};--soft:#f6f4f0;--accent:{{ section.settings.accent }};--gold:{{ section.settings.gold }};--serif:'Cormorant Garamond',Georgia,serif;--sans:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--ink);font-family:var(--sans)}
  #de-{{ section.id }} .de{max-width:1140px;margin:auto;padding:84px 28px}
  #de-{{ section.id }} .de-kicker{font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);text-align:center;font-weight:500}
  #de-{{ section.id }} h2{font-family:var(--serif);font-weight:500;font-size:clamp(38px,6vw,64px);text-align:center;margin:14px 0 0;line-height:1.05}
  #de-{{ section.id }} .de-sub{max-width:560px;margin:18px auto 0;text-align:center;color:var(--muted);font-size:16px;font-weight:300;line-height:1.65}
  #de-{{ section.id }} .de-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:64px}
  #de-{{ section.id }} .de-c{position:relative;padding:14px 30px}
  #de-{{ section.id }} .de-c + .de-c{border-left:1px solid var(--line)}
  #de-{{ section.id }} .de-wm{font-family:var(--serif);font-size:74px;line-height:1;color:var(--soft);font-weight:600;margin-bottom:-18px}
  #de-{{ section.id }} .de-c h3{font-family:var(--serif);font-size:27px;font-weight:600;margin:0 0 10px}
  #de-{{ section.id }} .de-c p{font-size:14px;line-height:1.7;color:var(--muted);font-weight:300;margin:0 0 18px}
  #de-{{ section.id }} .de-val{font-size:11.5px;letter-spacing:1.5px;text-transform:uppercase;color:var(--accent);font-weight:500;display:flex;align-items:center;gap:7px}
  #de-{{ section.id }} .de-val::before{content:"◆";font-size:9px}
  #de-{{ section.id }} .de-scales{margin-top:80px;display:grid;gap:42px}
  #de-{{ section.id }} .scale-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px}
  #de-{{ section.id }} .scale-head .lab{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;font-weight:600}
  #de-{{ section.id }} .scale-head .note{color:var(--gold);font-family:var(--serif);font-size:15px;font-style:italic}
  #de-{{ section.id }} .track{position:relative;height:3px;background:var(--line);border-radius:3px}
  #de-{{ section.id }} .fill{position:absolute;top:0;height:3px;border-radius:3px;background:linear-gradient(90deg,#c9bdec,var(--accent))}
  #de-{{ section.id }} .dot{position:absolute;top:50%;width:13px;height:13px;border-radius:50%;background:#fff;border:2.5px solid var(--accent);transform:translate(-50%,-50%);box-shadow:0 2px 8px rgba(106,79,182,.35);transition:left .45s cubic-bezier(.4,0,.2,1)}
  #de-{{ section.id }} .ticks{display:flex;justify-content:space-between;margin-top:12px;font-size:11px;letter-spacing:1px;color:var(--muted)}
  #de-{{ section.id }} .clarity-grades{display:flex;gap:6px;margin-top:18px;flex-wrap:wrap}
  #de-{{ section.id }} .clarity-grades button{font-family:var(--sans);font-size:12px;border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:30px;padding:7px 14px;cursor:pointer;transition:.18s;font-weight:500}
  #de-{{ section.id }} .clarity-grades button:hover{border-color:var(--accent);color:var(--accent)}
  #de-{{ section.id }} .clarity-grades button.active{background:var(--accent);border-color:var(--accent);color:#fff}
  #de-{{ section.id }} .clarity-grades button.svz{position:relative}
  #de-{{ section.id }} .clarity-grades button.svz::after{content:"";position:absolute;top:-3px;right:-3px;width:7px;height:7px;background:var(--gold);border-radius:50%}
  #de-{{ section.id }} .clarity-msg{margin-top:16px;font-family:var(--serif);font-size:19px;min-height:26px;font-weight:500}
  #de-{{ section.id }} .clarity-msg b{color:var(--accent)}
  @media(max-width:820px){
    #de-{{ section.id }} .de{padding:60px 22px}
    #de-{{ section.id }} .de-grid{grid-template-columns:1fr 1fr}
    #de-{{ section.id }} .de-c{padding:26px 20px;border-left:1px solid var(--line)}
    #de-{{ section.id }} .de-c:nth-child(odd){border-left:none}
    #de-{{ section.id }} .de-c:nth-child(n+3){border-top:1px solid var(--line)}
  }
  @media(max-width:520px){
    #de-{{ section.id }} .de-grid{grid-template-columns:1fr}
    #de-{{ section.id }} .de-c{border-left:none!important;border-top:1px solid var(--line)}
    #de-{{ section.id }} .de-c:first-child{border-top:none}
    #de-{{ section.id }} .de-wm{font-size:60px}
  }
</style>

<div id="de-{{ section.id }}">
  <section class="de">
    <div class="de-kicker">{{ section.settings.kicker }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p class="de-sub">{{ section.settings.intro }}</p>

    <div class="de-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'c' -%}
          <div class="de-c" {{ block.shopify_attributes }}>
            <div class="de-wm">{{ block.settings.symbol }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
            <div class="de-val">Svadezi · {{ block.settings.value }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="de-scales">
      <!-- interactive clarity -->
      <div>
        <div class="scale-head"><span class="lab">Clarity scale — tap a grade</span><span class="note">Svadezi floor highlighted</span></div>
        <div class="track"><div class="fill" id="cl-fill-{{ section.id }}" style="left:0;width:78%"></div><div class="dot" id="cl-dot-{{ section.id }}" style="left:78%"></div></div>
        <div class="clarity-grades" id="cl-grades-{{ section.id }}"></div>
        <div class="clarity-msg" id="cl-msg-{{ section.id }}"></div>
      </div>
      <!-- colour -->
      <div>
        <div class="scale-head"><span class="lab">Colour scale</span><span class="note">{{ section.settings.colour_note }}</span></div>
        <div class="track"><div class="fill" style="left:66%;width:22%"></div><div class="dot" style="left:77%"></div></div>
        <div class="ticks"><span>K–M</span><span>H–J</span><span>G</span><span>E–F</span><span>D</span></div>
      </div>
      <!-- cut -->
      <div>
        <div class="scale-head"><span class="lab">Cut grade</span><span class="note">{{ section.settings.cut_note }}</span></div>
        <div class="track"><div class="fill" style="left:0;width:100%"></div><div class="dot" style="left:100%"></div></div>
        <div class="ticks"><span>Fair</span><span>Good</span><span>Very Good</span><span>Excellent</span></div>
      </div>
      <!-- carat -->
      <div>
        <div class="scale-head"><span class="lab">Carat range</span><span class="note">{{ section.settings.carat_note }}</span></div>
        <div class="track"><div class="fill" style="left:5%;width:90%"></div><div class="dot" style="left:5%"></div><div class="dot" style="left:95%"></div></div>
        <div class="ticks"><span>0.10</span><span>0.50</span><span>1.00</span><span>1.50</span><span>2.00</span></div>
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  var sid = {{ section.id | json }};
  var grades = [
    {g:'I',   t:'Included — visible inclusions.'},
    {g:'SI2', t:'Slightly Included — flaws seen under 10×.'},
    {g:'SI1', t:'Slightly Included — minor under 10×.'},
    {g:'VS2', t:'Very Slightly Included — hard to spot.'},
    {g:'VS1', t:'Very Slightly Included — the Svadezi floor.', svz:true},
    {g:'VVS2',t:'Very, Very Slightly Included — exceptional.', svz:true},
    {g:'VVS1',t:'Very, Very Slightly Included — near-flawless.', svz:true},
    {g:'IF',  t:'Internally Flawless — flawless within.'},
    {g:'FL',  t:'Flawless — the rarest grade.'}
  ];
  var wrap=document.getElementById('cl-grades-'+sid),dot=document.getElementById('cl-dot-'+sid),fill=document.getElementById('cl-fill-'+sid),msg=document.getElementById('cl-msg-'+sid);
  function select(i){
    [].forEach.call(wrap.children,function(b,j){b.classList.toggle('active',j===i)});
    var pct=(i/(grades.length-1))*100; dot.style.left=pct+'%'; fill.style.width=pct+'%';
    msg.innerHTML='<b>'+grades[i].g+'</b> — '+grades[i].t;
  }
  grades.forEach(function(o,i){var b=document.createElement('button');b.textContent=o.g;if(o.svz)b.className='svz';b.onclick=function(){select(i)};wrap.appendChild(b);});
  select(4);
})();
</script>

{% schema %}
{
  "name": "Diamond Education",
  "settings": [
    { "type": "text", "id": "kicker",  "label": "Kicker", "default": "The Standard We Hold" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Four Cs, demystified" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "A diamond's value lives in four measurable qualities — here's where every Svadezi stone lands on the scale." },
    { "type": "header", "content": "Scale captions" },
    { "type": "text", "id": "colour_note", "label": "Colour note", "default": "Near-colourless E–F" },
    { "type": "text", "id": "cut_note",    "label": "Cut note",    "default": "Excellent" },
    { "type": "text", "id": "carat_note",  "label": "Carat note",  "default": "0.10 – 2.00 ct" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg",     "label": "Background", "default": "#fffdfb" },
    { "type": "color", "id": "accent", "label": "Accent",     "default": "#6a4fb6" },
    { "type": "color", "id": "gold",   "label": "Gold detail","default": "#b0935e" }
  ],
  "blocks": [
    {
      "type": "c",
      "name": "C card",
      "settings": [
        { "type": "text",     "id": "symbol", "label": "Symbol", "default": "Ct" },
        { "type": "text",     "id": "title",  "label": "Title",  "default": "Carat" },
        { "type": "textarea", "id": "text",   "label": "Text",   "default": "Weight, not size. We list a precise carat for every stone." },
        { "type": "text",     "id": "value",  "label": "Svadezi value", "default": "0.10 – 2.00 ct" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Diamond Education",
    "blocks": [
      { "type": "c", "settings": { "symbol": "Ct", "title": "Carat",   "text": "Weight, not size. We list a precise carat for every stone, so you compare like-for-like — never a vague 'diamond-studded'.", "value": "0.10 – 2.00 ct" } },
      { "type": "c", "settings": { "symbol": "Cl", "title": "Clarity", "text": "How free the diamond is of inclusions. We hold a VVS–VS floor — cleaner than most high-street retail.", "value": "VVS – VS" } },
      { "type": "c", "settings": { "symbol": "Co", "title": "Colour",  "text": "The whiter, the rarer. Our diamonds sit in the near-colourless E–F band for an icy, bright face.", "value": "E – F" } },
      { "type": "c", "settings": { "symbol": "Cu", "title": "Cut",     "text": "The one C made by human hands. Surat-mastered proportions return maximum fire and scintillation.", "value": "Excellent" } }
    ]
  }]
}
{% endschema %}

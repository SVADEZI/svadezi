{%- comment -%}
  SVADEZI — Custom Product Section (Online Store 2.0)
  How to use:
  1. Shopify Admin → Online Store → Themes → ... → Edit code
  2. Sections → Add a new section → name it "svadezi-product" → paste this file
  3. Go to a Product template (Customize) → Add section → "SVADEZI Product"
  Trust badges, crystal meaning & care text are all editable in the theme editor.
{%- endcomment -%}

<style>
  .svz{--ink:#1d1b22;--muted:#6b6675;--line:#e9e6ef;--soft:#f7f5fb;--brand:{{ section.settings.brand_color }};--brand-dk:#523c93;--ok:#2e8b57;max-width:1120px;margin:auto;padding:24px 20px;color:var(--ink)}
  .svz *{box-sizing:border-box}
  .svz-pdp{display:grid;grid-template-columns:1.05fr .95fr;gap:48px}
  @media(max-width:880px){.svz-pdp{grid-template-columns:1fr;gap:28px}}
  .svz-main img{width:100%;border:1px solid var(--line);border-radius:14px;aspect-ratio:1/1;object-fit:cover}
  .svz-thumbs{display:flex;gap:10px;margin-top:12px}
  .svz-thumbs img{flex:1;aspect-ratio:1/1;object-fit:cover;border:1px solid var(--line);border-radius:10px;cursor:pointer}
  .svz-thumbs img.active{border-color:var(--brand);box-shadow:0 0 0 2px rgba(106,79,182,.25)}
  .svz-rating{font-size:13.5px;color:var(--muted)}
  .svz-rating .s{color:#e6b800;letter-spacing:2px}
  .svz h1{font-size:27px;margin:8px 0 4px;font-weight:700;line-height:1.2}
  .svz-sku{font-size:12px;color:var(--muted)}
  .svz-price{display:flex;align-items:baseline;gap:12px;margin:16px 0 4px}
  .svz-price .now{font-size:28px;font-weight:800}
  .svz-price .was{color:var(--muted);text-decoration:line-through;font-size:17px}
  .svz-price .off{background:#eafaf1;color:var(--ok);font-weight:700;font-size:13px;padding:3px 9px;border-radius:20px}
  .svz-tax{font-size:12px;color:var(--muted);margin-bottom:14px}
  .svz form{margin:0}
  .svz-opt{margin:18px 0}
  .svz-opt label{display:block;font-size:13px;font-weight:700;margin-bottom:8px}
  .svz-opt select{width:100%;max-width:260px;border:1px solid var(--line);border-radius:10px;padding:11px;font-size:14px}
  .svz-cta{width:100%;background:var(--brand);color:#fff;border:none;border-radius:12px;padding:15px;font-size:15px;font-weight:700;cursor:pointer;margin-top:6px}
  .svz-cta:hover{background:var(--brand-dk)}
  .svz-buy{width:100%;background:var(--ink);color:#fff;border:none;border-radius:12px;padding:15px;font-size:15px;font-weight:700;cursor:pointer;margin-top:10px}
  .svz-deliver{border:1px solid var(--line);border-radius:12px;padding:14px;margin:18px 0;font-size:13.5px}
  .svz-deliver .row{display:flex;gap:10px;margin:7px 0}
  .svz-deliver .dot{color:var(--ok);font-weight:800}
  .svz-trust{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:20px 0}
  @media(max-width:520px){.svz-trust{grid-template-columns:repeat(2,1fr)}}
  .svz-trust div{background:var(--soft);border-radius:12px;padding:12px 8px;text-align:center;font-size:11.5px;font-weight:600;color:var(--brand-dk)}
  .svz-trust .ic{font-size:20px;display:block;margin-bottom:4px}
  .svz-tabs{max-width:1120px;margin:48px auto 0;padding:0 20px}
  .svz-tabnav{display:flex;gap:6px;border-bottom:1px solid var(--line);overflow-x:auto}
  .svz-tabnav button{border:none;background:none;padding:14px 18px;font-size:14.5px;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap}
  .svz-tabnav button.active{color:var(--brand);border-bottom-color:var(--brand)}
  .svz-panel{display:none;padding:22px 2px;font-size:14.5px;color:#3b3744;max-width:760px}
  .svz-panel.active{display:block}
  .svz-crystal{background:var(--soft);border-radius:14px;padding:18px 20px;margin-top:8px}
</style>

<div class="svz">
  <div class="svz-pdp">
    <!-- GALLERY -->
    <div>
      <div class="svz-main">
        {%- if product.featured_image -%}
          <img id="svz-main-img" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}">
        {%- else -%}
          <img id="svz-main-img" src="{{ 'product-1' | placeholder_svg_tag }}" alt="">
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="svz-thumbs">
          {%- for image in product.images limit: 5 -%}
            <img src="{{ image | image_url: width: 200 }}" data-full="{{ image | image_url: width: 900 }}"
                 class="{% if forloop.first %}active{% endif %}" alt="" onclick="svzSwap(this)">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- BUY BOX -->
    <div>
      <div class="svz-rating"><span class="s">★★★★★</span> {{ section.settings.rating }} · {{ section.settings.review_count }} reviews</div>
      <h1>{{ product.title }}</h1>
      <div class="svz-sku">SKU: {{ product.selected_or_first_available_variant.sku }} · {{ section.settings.material }}</div>

      <div class="svz-price">
        <span class="now">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="was">{{ product.compare_at_price | money }}</span>
          <span class="off">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>
        {%- endif -%}
      </div>
      <div class="svz-tax">Inclusive of all taxes · Chain included</div>

      <form method="post" action="/cart/add">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="svz-opt">
              <label>{{ option.name }}</label>
              <select name="options[{{ option.name | escape }}]">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {%- if product.available -%}
          <button type="submit" class="svz-cta">Add to Bag</button>
        {%- else -%}
          <button type="button" class="svz-cta" disabled style="opacity:.5">Sold Out</button>
        {%- endif -%}
      </form>

      <!-- delivery -->
      <div class="svz-deliver">
        <div class="row"><span class="dot">●</span> {{ section.settings.ship_line }}</div>
        <div class="row"><span class="dot">●</span> Cash on Delivery available</div>
        <div class="row"><span class="dot">●</span> {{ section.settings.return_line }}</div>
      </div>

      <!-- trust -->
      <div class="svz-trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div {{ block.shopify_attributes }}><span class="ic">{{ block.settings.icon }}</span>{{ block.settings.text }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="svz-tabs">
  <div class="svz-tabnav">
    <button class="active" onclick="svzTab(this,'desc')">Description</button>
    <button onclick="svzTab(this,'crystal')">Crystal &amp; Care</button>
    <button onclick="svzTab(this,'ship')">Shipping &amp; Returns</button>
  </div>
  <div class="svz-panel active" id="svz-desc">{{ product.description }}</div>
  <div class="svz-panel" id="svz-crystal">
    <div class="svz-crystal">{{ section.settings.crystal_text }}</div>
    <p style="margin-top:16px">{{ section.settings.care_text }}</p>
  </div>
  <div class="svz-panel" id="svz-ship">{{ section.settings.shipping_text }}</div>
</div>

<script>
  function svzSwap(t){
    document.getElementById('svz-main-img').src = t.dataset.full;
    document.querySelectorAll('.svz-thumbs img').forEach(function(i){i.classList.remove('active')});
    t.classList.add('active');
  }
  function svzTab(btn,id){
    document.querySelectorAll('.svz-tabnav button').forEach(function(b){b.classList.remove('active')});
    btn.classList.add('active');
    document.querySelectorAll('.svz-panel').forEach(function(p){p.classList.remove('active')});
    document.getElementById('svz-'+id).classList.add('active');
  }
</script>

{% schema %}
{
  "name": "SVADEZI Product",
  "settings": [
    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#6a4fb6" },
    { "type": "text", "id": "material", "label": "Material line", "default": "925 Sterling Silver" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "126" },
    { "type": "text", "id": "ship_line", "label": "Shipping line", "default": "Ships in 24–48 hrs · Free shipping over ₹999" },
    { "type": "text", "id": "return_line", "label": "Returns line", "default": "7-day easy returns & exchange" },
    { "type": "richtext", "id": "crystal_text", "label": "Crystal meaning", "default": "<p>💜 Amethyst is the stone of calm, clarity and intuition.</p>" },
    { "type": "richtext", "id": "care_text", "label": "Care text", "default": "<p>Keep away from perfume & water, store in the pouch provided, and wipe gently with the cloth included.</p>" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns text", "default": "<p>Free shipping over ₹999 · COD available · 7-day easy returns on unworn items with tags & certificate.</p>" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🛡️" },
        { "type": "text", "id": "text", "label": "Text", "default": "BIS Hallmarked" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "SVADEZI Product",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🛡️", "text": "BIS Hallmarked" } },
        { "type": "badge", "settings": { "icon": "✨", "text": "Anti-Tarnish" } },
        { "type": "badge", "settings": { "icon": "🤍", "text": "Nickel-Free" } },
        { "type": "badge", "settings": { "icon": "📜", "text": "Authenticity Cert." } }
      ]
    }
  ]
}
{% endschema %}
